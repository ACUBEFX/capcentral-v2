
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Welcome | CapCentral</title>

    <link rel="stylesheet" href="/css/styles.css">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #007bff, #00c6ff);
            padding: 20px;
        }

        .container {
            width: 100%;
            max-width: 520px;
            background: rgba(255, 255, 255, 0.98);
            padding: 45px 35px;
            border-radius: 22px;
            text-align: center;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.18);
            animation: fadeIn 0.8s ease;
        }

        .logo {
            font-size: 28px;
            font-weight: 800;
            color: #007bff;
            margin-bottom: 25px;
            letter-spacing: 0.5px;
        }

        .success-icon {
            width: 85px;
            height: 85px;
            margin: 0 auto 25px;
            border-radius: 50%;
            background: #e8f8ee;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #28a745;
            font-size: 45px;
            font-weight: bold;
            animation: pop 0.6s ease;
        }

        h1 {
            color: #1f2937;
            font-size: 32px;
            margin-bottom: 12px;
        }

        .username {
            color: #007bff;
        }

        .message {
            color: #6b7280;
            font-size: 17px;
            line-height: 1.6;
            margin-bottom: 25px;
        }

        .status {
            background: #f0f7ff;
            border-left: 4px solid #007bff;
            padding: 15px;
            border-radius: 8px;
            color: #4b5563;
            font-size: 14px;
            margin-bottom: 25px;
        }

        .countdown {
            font-weight: 700;
            color: #007bff;
        }

        .button {
            display: inline-block;
            padding: 13px 28px;
            background: linear-gradient(135deg, #007bff, #0056d6);
            color: white;
            text-decoration: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 6px 15px rgba(0, 123, 255, 0.25);
        }

        .button:hover {
            transform: translateY(-2px);
            box-shadow: 0 9px 20px rgba(0, 123, 255, 0.35);
        }

        .footer {
            margin-top: 30px;
            color: #9ca3af;
            font-size: 13px;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(25px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes pop {
            0% {
                transform: scale(0.5);
                opacity: 0;
            }

            70% {
                transform: scale(1.1);
            }

            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        @media (max-width: 480px) {
            .container {
                padding: 35px 22px;
            }

            h1 {
                font-size: 27px;
            }

            .message {
                font-size: 15px;
            }

            .success-icon {
                width: 75px;
                height: 75px;
                font-size: 38px;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="logo">
            CapCentral
        </div>

        <div class="success-icon">
            ✓
        </div>

        <h1>
            Welcome, <span class="username"><%= username %></span>!
        </h1>

        <p class="message">
            You have successfully logged in to your CapCentral account.
        </p>

        <div class="status">
            You will be redirected to the CapCentral homepage in
            <span class="countdown" id="countdown">3</span> seconds.
        </div>

        <a href="/products" class="button">
            Continue to CapCentral
        </a>

        <div class="footer">
            &copy; 2026 CapCentral. All rights reserved.
        </div>

    </div>

    <script>
        let seconds = 6;

        const countdown = document.getElementById("countdown");

        const timer = setInterval(function () {
            seconds--;

            countdown.textContent = seconds;

            if (seconds <= 0) {
                clearInterval(timer);
            }
        }, 1000);

        setTimeout(function () {
            window.location.href = "/products";
        }, 6000);
    </script>

</body>

</html>



