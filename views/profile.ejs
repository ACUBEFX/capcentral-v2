<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>CapCentral | Profile Dashboard</title>
  <link rel="stylesheet" href="/css/profile.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    body {
      margin: 0;
      font-family: 'Segoe UI', sans-serif;
      background-color: #f4f6f9;
    }

    .dashboard-container {
      display: flex;
      height: 100vh;
    }

    /* Sidebar styling */
    .sidebar {
      width: 250px;
      background-color: #1a1a1a;
      color: #fff;
      padding: 2rem 1.5rem;
      display: flex;
      flex-direction: column;
      transition: transform 0.3s ease;
      z-index: 1000;
    }

    .sidebar h2 {
      font-size: 1.5rem;
      margin-bottom: 2rem;
      color: #e0e0e0;
    }

    .sidebar ul {
      list-style: none;
      padding: 0;
      flex-grow: 1;
    }

    .sidebar li {
      margin: 1rem 0;
    }

    .sidebar a {
      color: #fff;
      text-decoration: none;
      font-weight: 500;
      display: flex;
      align-items: center;
    }

    .sidebar a i {
      margin-right: 10px;
      font-size: 1rem;
    }

    .sidebar a:hover {
      color: #f8fafc;
    }

    .logout {
      margin-top: auto;
    }

    /* Back Button */
    .back-btn {
      position: fixed;
      top: 20px;
      left: 1.5rem;
      padding: 0.3rem 1rem;
      padding-bottom: 2px;
      margin-bottom: 1px;
      background: rgba(255, 255, 255, 0.9);
      color: black;
      border: none;
      border-radius: 50px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.3s ease, transform 0.3s ease;
      display: flex;
      align-items: center;
      gap: 0.3rem;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
      z-index: 1100;
    }

    .back-btn:hover {
      background: #f1f1f1;
      transform: translateX(-3px);
    }

    .back-btn i {
      font-size: 1.2rem;
    }

    /* Main content styling */
    .main-content {
      flex: 1;
      padding: 3rem;
      overflow-y: auto;
    }

    .main-content h1 {
      font-size: 2rem;
      margin-bottom: 2rem;
      color: #333;
    }

    .profile-form {
      max-width: 500px;
      background: #fff;
      padding: 2rem;
      border-radius: 12px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-group label {
      display: block;
      margin-bottom: 0.6rem;
      font-weight: 600;
    }

    .form-group input {
      width: 93%;
      padding: 0.8rem;
      border-radius: 6px;
      border: 1px solid #ccc;
      font-size: 1rem;
    }

    button[type="submit"] {
      background-color: #050505;
      color: white;
      padding: 0.9rem 2rem;
      border: none;
      border-radius: 6px;
      font-size: 1rem;
      cursor: pointer;
      transition: background 0.3s ease;
    }

    button[type="submit"]:hover {
      background-color: #005fa3;
    }

    /* Disable the inputs by default */
    .profile-form input:disabled {
      background-color: #f0f0f0;
      cursor: not-allowed;
    }

    /* Hamburger Menu */
    .burger {
      display: none;
      position: fixed;
      top: 20px;
      left: 1.5rem;
      font-size: 1.5rem;
      color: #333;
      cursor: pointer;
      z-index: 1100;
    }

    .overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(0, 0, 0, 0.5);
      z-index: 900;
    }

    @media (max-width: 768px) {
      .dashboard-container {
        flex-direction: column;
      }

      .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        transform: translateX(-100%);
      }

      .sidebar.active {
        transform: translateX(0);
      }

      .burger {
        display: block;
        top: 60px; /* Push burger below back button */
        left: 1.5rem;
      }

      .back-btn {
        top: 20px;
        left: 1.5rem;
      }

      .overlay.active {
        display: block;
      }
    }

    .modal-overlay {
  position: fixed;
  top: 0; left: 0;
  width: 100vw; height: 100vh;
  background: rgba(0, 0, 0, 0.6);
  display: none;
  justify-content: center;
  align-items: center;
  z-index: 2000;
}

.modal {
  background: #fff;
  padding: 2rem;
  border-radius: 10px;
  text-align: center;
  max-width: 400px;
  width: 90%;
  box-shadow: 0 5px 20px rgba(0,0,0,0.2);
}

.modal-buttons {
  display: flex;
  justify-content: space-around;
  margin-top: 1.5rem;
}

.modal-buttons button {
  padding: 0.6rem 1.2rem;
  border: none;
  border-radius: 50%;
  font-size: 1rem;
  cursor: pointer;
}

#confirm-logout {
  background-color: #d32f2f;
  color: white;
}

#cancel-logout {
  background-color: #ccc;
}

  </style>

</head>
<body>
  <div class="burger" id="burger-menu">
    <i class="fas fa-bars"></i>
  </div>
  <button class="back-btn" onclick="window.history.back()">
    <i class="fas fa-arrow-left"></i> Back
  </button>
  <div class="overlay" id="overlay"></div>

  <div class="dashboard-container">
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
      <h2>Dashboard</h2>
      <ul>
        <li><a href="/dashboard"><i class="fas fa-user"></i> Profile</a></li>
        <li><a href="/cart"><i class="fas fa-shopping-cart"></i> Cart</a></li>
        <li><a href="/services"><i class="fas fa-concierge-bell"></i> Services</a></li>
      </ul>
      <div class="logout">
<a href="#" id="logout-link"><i class="fas fa-sign-out-alt"></i> Logout</a>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
      <h1>Welcome, <%= user.username %> 👋</h1>

      <form method="POST" action="/profile" class="profile-form" id="profile-form">
        <div class="form-group">
          <label>Username</label>
          <input type="text" name="username" value="<%= user.username %>" required disabled>
        </div>

        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" value="<%= user.email %>" required disabled>
        </div>

        <div class="form-group">
          <label>Phone Number</label>
          <input type="text" name="phone" value="<%= user.phone_number %>" required disabled>
        </div>

        <div class="form-group">
          <label>Address</label>
          <input type="text" name="address" value="<%= user.address %>" required disabled>
        </div>

        <button type="button" id="edit-btn">Edit Profile</button>
        <button type="submit" style="display: none;">Update Profile</button>
      </form>
    </main>
  </div>

  <!-- Logout Confirmation Modal -->
<div id="logout-modal" class="modal-overlay">
  <div class="modal">
    <h2>Confirm Logout</h2>
    <p>Are you sure you want to log out?</p>
    <div class="modal-buttons">
      <button id="confirm-logout">Logout</button>
      <button id="cancel-logout">Cancel</button>
    </div>
  </div>
</div>


  <script>
    const burger = document.getElementById('burger-menu');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('overlay');
    const editBtn = document.getElementById('edit-btn');
    const formInputs = document.querySelectorAll('.profile-form input');
    const submitBtn = document.querySelector('button[type="submit"]');

    // Toggle sidebar visibility
    burger.addEventListener('click', () => {
      sidebar.classList.toggle('active');
      overlay.classList.toggle('active');
    });

    overlay.addEventListener('click', () => {
      sidebar.classList.remove('active');
      overlay.classList.remove('active');
    });

    // Enable form inputs when 'Edit Profile' button is clicked
    editBtn.addEventListener('click', () => {
      formInputs.forEach(input => input.disabled = false); // Enable all form inputs
      editBtn.style.display = 'none'; // Hide the edit button
      submitBtn.style.display = 'inline-block'; // Show the submit button
    });

    const logoutLink = document.getElementById('logout-link');
const logoutModal = document.getElementById('logout-modal');
const confirmLogout = document.getElementById('confirm-logout');
const cancelLogout = document.getElementById('cancel-logout');

// Show modal on logout click
logoutLink.addEventListener('click', (e) => {
  e.preventDefault();
  logoutModal.style.display = 'flex';
});

// Confirm logout
confirmLogout.addEventListener('click', () => {
  window.location.href = '/logout';
});

// Cancel logout
cancelLogout.addEventListener('click', () => {
  logoutModal.style.display = 'none';
});

// Close with Escape key
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    logoutModal.style.display = 'none';
  }
});

  </script>
</body>
</html>
