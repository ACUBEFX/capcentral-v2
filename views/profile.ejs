
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#000000">
    <title>My Profile | CapCentral</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        :root {
            --primary-color: #333;
            --secondary-color: #555;
            --accent-color: #8B4513;
            --text-color: #333;
            --light-bg: #f5f5f5;
            --white: #fff;
            --border-radius: 10px;
            --box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        html {
            width: 100%;
            overflow-x: hidden;
        }

        body {
            width: 100%;
            min-height: 100vh;
            overflow-x: hidden;
            background: var(--light-bg);
            color: var(--text-color);
        }

        a {
            text-decoration: none;
        }

        button,
        input {
            font: inherit;
        }

        /* Header */
        header {
            width: 100%;
            min-height: 70px;
            padding: 10px 5%;
            background: #000;
            color: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            box-shadow: 0 2px 10px rgba(0, 0, 0, .1);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
            color: #fff;
        }

        .logo img {
            width: 60px;
            height: auto;
            object-fit: contain;
        }

        #brandname {
            font-family: 'Lora', serif;
            font-size: 23px;
            font-weight: 700;
            color: #fff;
        }

        .header-link {
            color: #fff;
            font-size: 13px;
            transition: var(--transition);
        }

        .header-link:hover {
            color: #d7a77c;
        }

        /* Navigation */
        body > nav.legacy-account-nav {
            width: 100%;
            padding: 13px 5%;
            background: var(--secondary-color);
        }

        .nav-container {
            max-width: 1200px;
            margin: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            list-style: none;
            gap: 25px;
        }

        .nav-links a {
            color: #fff;
            font-size: 13px;
            transition: var(--transition);
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: #d7a77c;
        }

        /* Main page */
        main {
            width: 100%;
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 25px;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 25px;
            color: var(--accent-color);
            font-size: 13px;
            font-weight: 600;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        .page-heading {
            text-align: center;
            margin-bottom: 32px;
        }

        .page-heading h1 {
            font-family: 'Lora', serif;
            font-size: 30px;
            margin-bottom: 10px;
            color: #222;
            overflow-wrap: anywhere;
        }

        .page-heading p {
            color: #666;
            font-size: 14px;
            line-height: 1.7;
        }

        .heading-line {
            width: 75px;
            height: 3px;
            margin: 15px auto 0;
            background: var(--accent-color);
        }

        /* Profile layout */
        .profile-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
            gap: 25px;
            align-items: start;
        }

        /* Profile information card */
        .profile-intro {
            padding: 28px 22px;
            background: #fff;
            border-radius: var(--border-radius);
            box-shadow: var(--box-shadow);
            text-align: center;
            border: 1px solid #eee;
        }

        .profile-avatar {
            width: 85px;
            height: 85px;
            margin: 0 auto 18px;
            border-radius: 50%;
            background: #faf5f0;
            color: var(--accent-color);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 35px;
        }

        .profile-intro h2 {
            font-family: 'Lora', serif;
            font-size: 20px;
            margin-bottom: 8px;
            overflow-wrap: anywhere;
        }

        .profile-intro p {
            color: #777;
            font-size: 12px;
            line-height: 1.7;
            overflow-wrap: anywhere;
        }

        .profile-badge {
            display: inline-block;
            margin-top: 18px;
            padding: 7px 13px;
            border-radius: 30px;
            background: #faf5f0;
            color: var(--accent-color);
            font-size: 11px;
            font-weight: 700;
        }

        /* Profile form card */
        .profile-card {
            min-width: 0;
            padding: 28px;
            background: #fff;
            border-radius: var(--border-radius);
            box-shadow: var(--box-shadow);
            border: 1px solid #eee;
        }

        .card-heading {
            padding-bottom: 18px;
            margin-bottom: 22px;
            border-bottom: 1px solid #eee;
        }

        .card-heading h2 {
            font-family: 'Lora', serif;
            font-size: 21px;
            margin-bottom: 7px;
        }

        .card-heading p {
            color: #777;
            font-size: 12px;
            line-height: 1.6;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 9px;
            color: #444;
            font-size: 12px;
            font-weight: 700;
        }

        .form-group label i {
            width: 18px;
            color: var(--accent-color);
        }

        .form-group input {
            width: 100%;
            min-width: 0;
            padding: 13px 14px;
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 7px;
            color: #333;
            font-size: 13px;
            outline: none;
            transition: var(--transition);
        }

        .form-group input:focus {
            border-color: var(--accent-color);
            box-shadow: 0 0 0 3px rgba(139, 69, 19, .1);
        }

        .form-group input:disabled {
            background: #f7f7f7;
            color: #666;
            cursor: not-allowed;
        }

        .form-hint {
            display: block;
            margin-top: 7px;
            color: #888;
            font-size: 10px;
            line-height: 1.5;
        }

        /* Buttons */
        .form-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 25px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 43px;
            padding: 12px 20px;
            border: none;
            border-radius: 7px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition);
        }

        .primary-btn {
            background: #000;
            color: #fff;
        }

        .primary-btn:hover {
            background: var(--accent-color);
        }

        .secondary-btn {
            background: #eee;
            color: #333;
        }

        .secondary-btn:hover {
            background: #ddd;
        }

        .logout-btn {
            background: #fff;
            color: #a52b2b;
            border: 1px solid #e7caca;
        }

        .logout-btn:hover {
            background: #a52b2b;
            color: #fff;
        }

        .form-actions button:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

        /* Account links */
        .account-links {
            margin-top: 25px;
            padding: 22px;
            background: #fff;
            border: 1px solid #eee;
            border-radius: var(--border-radius);
            box-shadow: var(--box-shadow);
        }

        .account-links h3 {
            font-family: 'Lora', serif;
            font-size: 17px;
            margin-bottom: 16px;
        }

        .account-link {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 14px 0;
            border-bottom: 1px solid #eee;
            color: #444;
            font-size: 12px;
            transition: var(--transition);
        }

        .account-link:last-child {
            border-bottom: none;
        }

        .account-link:hover {
            color: var(--accent-color);
        }

        .account-link span {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .account-link i {
            color: var(--accent-color);
        }

        /* Logout confirmation modal */
        .modal-overlay {
            position: fixed;
            inset: 0;
            z-index: 2000;
            display: none;
            justify-content: center;
            align-items: center;
            padding: 18px;
            background: rgba(0, 0, 0, .65);
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal {
            width: 100%;
            max-width: 400px;
            padding: 30px 25px;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 10px 35px rgba(0, 0, 0, .2);
            text-align: center;
        }

        .modal-icon {
            width: 55px;
            height: 55px;
            margin: 0 auto 17px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #faf0ed;
            color: #a52b2b;
            font-size: 22px;
        }

        .modal h2 {
            font-family: 'Lora', serif;
            font-size: 21px;
            margin-bottom: 10px;
        }

        .modal p {
            color: #777;
            font-size: 13px;
            line-height: 1.7;
        }

        .modal-buttons {
            display: flex;
            gap: 12px;
            margin-top: 25px;
        }

        .modal-buttons button {
            flex: 1;
        }

        .confirm-btn {
            background: #a52b2b;
            color: #fff;
        }

        .confirm-btn:hover {
            background: #801d1d;
        }

        /* Footer */
        footer {
            margin-top: 60px;
            padding: 28px 5%;
            background: #030303;
            color: #bbb;
            text-align: center;
        }

        footer p {
            font-size: 12px;
            line-height: 1.7;
        }

        /* Tablet */
        @media (max-width: 900px) {
            main {
                max-width: 100%;
                padding: 0 22px;
            }

            .profile-layout {
                grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
                gap: 18px;
            }

            .profile-card {
                padding: 23px;
            }
        }

        /* Mobile */
        @media (max-width: 700px) {
            header {
                padding: 12px 18px;
            }

            .logo img {
                width: 48px;
            }

            #brandname {
                font-size: 19px;
            }

            body > nav.legacy-account-nav {
                padding: 12px 18px;
            }

            .nav-container {
                justify-content: center;
            }

            .nav-links {
                justify-content: center;
                gap: 12px 20px;
            }

            .nav-links a {
                font-size: 12px;
            }

            main {
                margin: 25px auto;
                padding: 0 16px;
            }

            .page-heading h1 {
                font-size: 25px;
            }

            .profile-layout {
                grid-template-columns: 1fr;
            }

            .profile-intro {
                padding: 23px 18px;
            }

            .profile-avatar {
                width: 72px;
                height: 72px;
                font-size: 29px;
            }

            .profile-card {
                padding: 20px;
            }

            .account-links {
                padding: 18px;
            }

            footer {
                margin-top: 35px;
            }
        }

        /* Small phones */
        @media (max-width: 480px) {
            header {
                padding: 10px 12px;
            }

            .logo {
                gap: 8px;
            }

            .logo img {
                width: 40px;
            }

            #brandname {
                font-size: 17px;
            }

            .header-link {
                font-size: 11px;
            }

            body > nav.legacy-account-nav {
                padding: 10px 12px;
            }

            .nav-links {
                gap: 9px 14px;
            }

            .nav-links a {
                font-size: 11px;
            }

            main {
                margin: 20px auto;
                padding: 0 12px;
            }

            .page-heading h1 {
                font-size: 22px;
            }

            .page-heading p {
                font-size: 12px;
            }

            .profile-card {
                padding: 16px 13px;
            }

            .card-heading h2 {
                font-size: 18px;
            }

            .form-group input {
                padding: 12px 10px;
                font-size: 12px;
            }

            .form-actions {
                flex-direction: column;
            }

            .form-actions .btn {
                width: 100%;
            }

            .modal {
                padding: 25px 17px;
            }

            .modal-buttons {
                flex-direction: column;
            }
        }

        @media (max-width: 340px) {
            header {
                flex-wrap: wrap;
                justify-content: center;
            }

            .header-link {
                padding: 5px;
            }

            .nav-links {
                gap: 8px 12px;
            }

            .profile-intro h2 {
                font-size: 18px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                scroll-behavior: auto !important;
                transition-duration: .01ms !important;
            }
        }
    
/* Customer mobile navigation */
.mobile-nav-toggle {
    display: none;
    background: transparent;
    border: 0;
    padding: 8px;
    cursor: pointer;
}

.mobile-nav-toggle span {
    display: block;
    width: 25px;
    height: 3px;
    margin: 5px 0;
    background: #fff;
    border-radius: 2px;
}

@media (max-width: 700px) {
    body > nav.legacy-account-nav {
        position: relative;
    }

    .nav-container {
        justify-content: flex-end;
    }

    .mobile-nav-toggle {
        display: block;
    }

    .nav-links {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        flex-direction: column;
        align-items: center;
        gap: 18px;
        padding: 20px;
        background: var(--secondary-color);
        z-index: 200;
    }

    .nav-links.nav-active {
        display: flex;
    }
}
</style>
    <link rel="stylesheet" href="/customer-account-nav.css">
</head>

<body>

<%- include('partials/customer-account-nav', { activePage: 'profile' }) %>

<main>

    <a href="/products" class="back-link">
        <i class="fas fa-arrow-left"></i> Continue Shopping
    </a>

    <div class="page-heading">
        <h1>Welcome, <%= user.username %></h1>
        <p>Manage your personal information and account settings.</p>
        <div class="heading-line"></div>
    </div>

    <div class="profile-layout">

        <!-- Profile introduction -->
        <section class="profile-intro">
            <div class="profile-avatar">
                <i class="fas fa-user"></i>
            </div>

            <h2><%= user.username %></h2>

            <p><%= user.email %></p>

            <span class="profile-badge">
                <i class="fas fa-user-check"></i> Customer Account
            </span>
        </section>

        <!-- Profile editing -->
        <section class="profile-card">

            <div class="card-heading">
                <h2>Personal Information</h2>
                <p>View and update the information associated with your account.</p>
            </div>

            <form method="POST"
                  action="/profile"
                  id="profile-form">

                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="form-group">
                    <label for="username">
                        <i class="fas fa-user"></i> Username
                    </label>

                    <input type="text"
                           id="username"
                           name="username"
                           value="<%= user.username %>"
                           autocomplete="username"
                           required
                           disabled>
                </div>

                <div class="form-group">
                    <label for="email">
                        <i class="fas fa-envelope"></i> Email Address
                    </label>

                    <input type="email"
                           id="email"
                           name="email"
                           value="<%= user.email %>"
                           autocomplete="email"
                           required
                           disabled>
                </div>

                <div class="form-group">
                    <label for="phone">
                        <i class="fas fa-phone"></i> Phone Number
                    </label>

                    <input type="text"
                           id="phone"
                           name="phone"
                           value="<%= user.phone_number || '' %>"
                           autocomplete="tel"
                           disabled>
                </div>

                <div class="form-group">
                    <label for="address">
                        <i class="fas fa-location-dot"></i> Address
                    </label>

                    <input type="text"
                           id="address"
                           name="address"
                           value="<%= user.address || '' %>"
                           autocomplete="street-address"
                           disabled>
                    <small class="form-hint">
                        Keep your address up to date for easier checkout.
                    </small>
                </div>

                <div class="form-actions">
                    <button type="button"
                            class="btn primary-btn"
                            id="edit-btn">
                        <i class="fas fa-pen"></i> Edit Profile
                    </button>

                    <button type="submit"
                            class="btn primary-btn"
                            id="update-profile-btn"
                            style="display:none;">
                        <i class="fas fa-save"></i> Save Changes
                    </button>

                    <button type="button"
                            class="btn secondary-btn"
                            id="cancel-edit-btn"
                            style="display:none;">
                        <i class="fas fa-times"></i> Cancel
                    </button>
                </div>

            </form>

        </section>

    </div>

    <!-- Account navigation -->
    <section class="account-links">

        <h3>Account & Shopping</h3>

        <a href="/my-deliveries" class="account-link">
            <span>
                <i class="fas fa-truck"></i>
                My Deliveries
            </span>
            <i class="fas fa-chevron-right"></i>
        </a>

        <a href="/products?openCart=1" class="account-link">
            <span>
                <i class="fas fa-shopping-cart"></i>
                My Shopping Cart
            </span>
            <i class="fas fa-chevron-right"></i>
        </a>

        <a href="/products" class="account-link">
            <span>
                <i class="fas fa-store"></i>
                Continue Shopping
            </span>
            <i class="fas fa-chevron-right"></i>
        </a>

        <a href="/services" class="account-link">
            <span>
                <i class="fas fa-concierge-bell"></i>
                Our Services
            </span>
            <i class="fas fa-chevron-right"></i>
        </a>

        <a href="#" class="account-link" id="logout-link">
            <span>
                <i class="fas fa-sign-out-alt"></i>
                Logout
            </span>
            <i class="fas fa-chevron-right"></i>
        </a>

    </section>

</main>

<footer>
    <p>&copy; <%= new Date().getFullYear() %> CapCentral. All rights reserved.</p>
</footer>

<!-- Logout confirmation modal -->
<div id="logout-modal" class="modal-overlay">

    <div class="modal">

        <div class="modal-icon">
            <i class="fas fa-sign-out-alt"></i>
        </div>

        <h2>Confirm Logout</h2>

        <p>Are you sure you want to log out of your CapCentral account?</p>

        <div class="modal-buttons">
            <button type="button"
                    id="confirm-logout"
                    class="btn confirm-btn">
                Logout
            </button>

            <button type="button"
                    id="cancel-logout"
                    class="btn secondary-btn">
                Cancel
            </button>
        </div>

        <form id="logout-form" action="/logout" method="POST" hidden>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        </form>

    </div>

</div>

<script src="/csrf-client.js"></script>
<script>
    const profileForm = document.getElementById('profile-form');
    const editBtn = document.getElementById('edit-btn');
    const updateBtn = document.getElementById('update-profile-btn');
    const cancelEditBtn = document.getElementById('cancel-edit-btn');

    const editableInputs = profileForm.querySelectorAll(
        'input:not([type="hidden"])'
    );

    const originalValues = Array.from(editableInputs).map(input => input.value);

    function setEditing(enabled) {
        editableInputs.forEach(input => {
            input.disabled = !enabled;
        });

        editBtn.style.display = enabled ? 'none' : 'inline-flex';
        updateBtn.style.display = enabled ? 'inline-flex' : 'none';
        cancelEditBtn.style.display = enabled ? 'inline-flex' : 'none';
    }

    editBtn.addEventListener('click', () => {
        setEditing(true);
        document.getElementById('username').focus();
    });

    cancelEditBtn.addEventListener('click', () => {
        editableInputs.forEach((input, index) => {
            input.value = originalValues[index];
        });

        setEditing(false);
    });

    // Logout modal
    const logoutLink = document.getElementById('logout-link');
    const logoutModal = document.getElementById('logout-modal');
    const confirmLogout = document.getElementById('confirm-logout');
    const cancelLogout = document.getElementById('cancel-logout');

    function openLogoutModal(event) {
        event.preventDefault();
        logoutModal.classList.add('active');
        cancelLogout.focus();
    }

    function closeLogoutModal() {
        logoutModal.classList.remove('active');
        logoutLink.focus();
    }

    logoutLink.addEventListener('click', openLogoutModal);

    cancelLogout.addEventListener('click', closeLogoutModal);

    confirmLogout.addEventListener('click', () => {
        document.getElementById('logout-form').requestSubmit();
    });

    logoutModal.addEventListener('click', event => {
        if (event.target === logoutModal) {
            closeLogoutModal();
        }
    });

    document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && logoutModal.classList.contains('active')) {
            closeLogoutModal();
        }
    });</script>

    <script src="/customer-account-nav.js" defer></script>
    <script src="/customer-bottom-nav.js" defer></script>
</body>
</html>







