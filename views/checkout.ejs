<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Checkout</title>
    <style>
        /* Reset and base */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background-color: #f7f8fa;
            color: #333;
            padding: 20px;
            display: flex;
            justify-content: center;
        }
        .checkout-container {
            background: white;
            max-width: 480px;
            width: 100%;
            border-radius: 8px;
            box-shadow: 0 4px 12px rgb(0 0 0 / 0.1);
            padding: 30px;
        }
        h1, h2, h3 {
            margin-bottom: 20px;
            color: #222;
        }
        ul {
            list-style: none;
            margin-bottom: 25px;
        }
        ul li {
            background: #f1f3f5;
            padding: 12px 15px;
            border-radius: 5px;
            margin-bottom: 10px;
            font-size: 1rem;
            color: #444;
        }
        form {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        input[type="email"] {
            padding: 12px 15px;
            font-size: 1rem;
            border-radius: 6px;
            border: 1.5px solid #ccc;
            transition: border-color 0.3s ease;
        }
        input[type="email"]:focus {
            outline: none;
            border-color: #007bff;
            box-shadow: 0 0 6px rgba(0,123,255,0.4);
        }
        button[type="submit"] {
            background-color: #007bff;
            color: white;
            padding: 15px;
            font-size: 1.1rem;
            font-weight: 600;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }
        button[type="submit"]:hover {
            background-color: #0056b3;
        }
        @media (max-width: 500px) {
            body {
                padding: 15px;
            }
            .checkout-container {
                padding: 20px;
            }
            ul li {
                font-size: 0.9rem;
            }
            button[type="submit"] {
                font-size: 1rem;
                padding: 12px;
            }
        }
    </style>
</head>
<body>
    <div class="checkout-container">
        <h1>Checkout</h1>
        <div>
            <h2>Your Cart</h2>
            <ul>
                <% cart.forEach(function(item){ %>
                    <li>
                        <%= item.name %> - Size: <%= item.size %> - Qty: <%= item.quantity %> - Price: ₦<%= item.price.toLocaleString() %>
                    </li>
                <% }); %>
            </ul>
            <h3>Total: ₦<%= Number(total).toLocaleString() %></h3>
        </div>
        <form action="/checkout/pay" method="POST">
            <input type="hidden" name="total" value="<%= total %>">
            <input type="email" name="email" required placeholder="Enter your email" />
            <button type="submit">Pay with Paystack</button>
        </form>
    </div>
</body>
</html>
