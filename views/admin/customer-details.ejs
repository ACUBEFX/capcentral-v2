<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Customer Details | CapCentral Admin</title><style>
*{box-sizing:border-box}body{margin:0;background:#f4f6fb;color:#1e293b;font-family:Arial,sans-serif}.top{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;background:#fff;padding:20px 28px;border-bottom:1px solid #e2e8f0}main{max-width:1600px;margin:auto;padding:24px}h1{font-size:24px;margin:0 0 6px}.muted{color:#64748b;font-size:13px;line-height:1.5}.panel{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:18px;margin-bottom:20px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px}.label{font-size:12px;color:#64748b;margin-bottom:5px}.value{font-weight:600;overflow-wrap:anywhere}.button{display:inline-block;border:0;border-radius:7px;padding:9px 12px;background:#172554;color:#fff;text-decoration:none;font-weight:600;font-size:13px}.secondary{background:#475569}.green{background:#15803d}.red{background:#b91c1c}.notice{padding:12px;border-radius:8px;background:#e5f7eb;color:#176337;margin-bottom:14px}.error{background:#fde8e8;color:#942b2b}.pill{display:inline-block;border-radius:20px;padding:4px 8px;background:#dcfce7;color:#166534}.no{background:#fee2e2;color:#991b1b}.table-wrap{overflow:auto;border:1px solid #e2e8f0;border-radius:10px}table{width:100%;border-collapse:collapse;min-width:700px}th,td{text-align:left;padding:11px;border-bottom:1px solid #e9edf2;font-size:12px;vertical-align:top;overflow-wrap:anywhere}th{background:#f8fafc;white-space:nowrap}.empty{text-align:center;color:#64748b;padding:24px}.actions{display:flex;gap:8px;flex-wrap:wrap}@media(max-width:650px){main{padding:12px}.top{padding:16px}}
</style></head><body><header class="top"><div><h1>Customer Details</h1><div class="muted">Account profile, orders and cap service history</div></div><div><a href="/admin/customers" class="button secondary">← All customers</a> <a href="/admin" class="button">Dashboard</a></div></header><main>
<% if (message) { %><div class="notice"><%= message %></div><% } %><section class="panel"><div class="grid"><div><div class="label">Customer ID</div><div class="value"><%= customer.id %></div></div><div><div class="label">Username</div><div class="value"><%= customer.username || '—' %></div></div><div><div class="label">Email</div><div class="value"><%= customer.email || '—' %></div></div><div><div class="label">Phone</div><div class="value"><%= customer.phone_number || '—' %></div></div><div><div class="label">Address</div><div class="value"><%= customer.address || '—' %></div></div><div><div class="label">Email verification</div><span class="pill <%= customer.is_verified ? '' : 'no' %>"><%= customer.is_verified ? 'Verified' : 'Not verified' %></span></div><div><div class="label">Account status</div><span class="pill <%= customer.is_active ? '' : 'no' %>"><%= customer.is_active ? 'Active' : 'Deactivated' %></span></div><div><div class="label">Registered</div><div class="value"><%= customer.created_at ? new Date(customer.created_at).toLocaleString('en-NG') : '—' %></div></div></div><hr style="border:0;border-top:1px solid #e2e8f0;margin:20px 0"><div class="actions"><a class="button" href="/admin/customers/<%= customer.id %>/edit">Edit details</a><form method="POST" action="/admin/customers/<%= customer.id %>/active"><input type="hidden" name="active" value="<%= customer.is_active ? '0' : '1' %>"><button class="button <%= customer.is_active ? 'red' : 'green' %>" type="submit"><%= customer.is_active ? 'Deactivate account' : 'Activate account' %></button></form><form method="POST" action="/admin/customers/<%= customer.id %>/delete" onsubmit="return confirm('Permanently delete this customer account? Historical order and service records will be retained where stored separately. This cannot be undone.');"><button class="button red" type="submit">Delete account</button></form></div></section>
<section class="panel"><h2>Orders (<%= orders.length %>)</h2><p class="muted">Matched by customer account ID and/or the email recorded on the order.</p><div class="table-wrap"><table><thead><tr><% const orderKeys = orders.length ? Object.keys(orders[0]) : []; orderKeys.forEach(key => { %><th><%= key.replace(/_/g,' ') %></th><% }); %></tr></thead><tbody><% if(!orders.length){ %><tr><td class="empty" colspan="<%= Math.max(orderKeys.length,1) %>">No orders found for this customer.</td></tr><% } else { orders.forEach(order => { %><tr><% orderKeys.forEach(key => { const value=order[key]; %><td><%= value === null || value === undefined || value === '' ? '—' : (value instanceof Date ? value.toLocaleString('en-NG') : String(value)) %></td><% }); %></tr><% }); } %></tbody></table></div></section>
<section class="panel"><h2>Cap services (<%= services.length %>)</h2><p class="muted">Matched by the email and, where available, phone number saved on service requests.</p><div class="table-wrap"><table><thead><tr><% const serviceKeys = services.length ? Object.keys(services[0]) : []; serviceKeys.forEach(key => { %><th><%= key.replace(/_/g,' ') %></th><% }); %></tr></thead><tbody><% if(!services.length){ %><tr><td class="empty" colspan="<%= Math.max(serviceKeys.length,1) %>">No cap services found for this customer.</td></tr><% } else { services.forEach(service => { %><tr><% serviceKeys.forEach(key => { const value=service[key]; %><td><%= value === null || value === undefined || value === '' ? '—' : (value instanceof Date ? value.toLocaleString('en-NG') : String(value)) %></td><% }); %></tr><% }); } %></tbody></table></div></section>
</main></body></html>
