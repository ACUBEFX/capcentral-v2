
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Customers | CapCentral Admin</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f4f6fb;
            color: #1e293b;
            font-family: Arial, sans-serif;
        }

        .top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
            background: #fff;
            padding: 20px 28px;
            border-bottom: 1px solid #e2e8f0;
        }

        h1 {
            font-size: 23px;
            margin: 0 0 6px;
        }

        .muted {
            color: #64748b;
            font-size: 13px;
            line-height: 1.5;
        }

        main {
            max-width: 1600px;
            margin: auto;
            padding: 24px;
        }

        .panel {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 18px;
            margin-bottom: 18px;
        }

        .button,
        button {
            display: inline-block;
            border: 0;
            border-radius: 7px;
            padding: 9px 12px;
            background: #172554;
            color: white;
            text-decoration: none;
            font-weight: 600;
            cursor: pointer;
            font-size: 12px;
        }

        .secondary {
            background: #475569;
        }

        .green {
            background: #15803d;
        }

        .red {
            background: #b91c1c;
        }

        .search {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .search input,
        .search select {
            padding: 10px;
            border: 1px solid #cbd5e1;
            border-radius: 7px;
            font: inherit;
        }

        .search input {
            flex: 1;
            min-width: 220px;
        }

        .table-wrap {
            overflow: auto;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 1050px;
        }

        th,
        td {
            text-align: left;
            padding: 12px;
            border-bottom: 1px solid #e9edf2;
            font-size: 13px;
            vertical-align: top;
            overflow-wrap: anywhere;
        }

        th {
            background: #f8fafc;
            white-space: nowrap;
        }

        .pill {
            display: inline-block;
            border-radius: 20px;
            padding: 4px 8px;
            background: #dcfce7;
            color: #166534;
        }

        .no {
            background: #fee2e2;
            color: #991b1b;
        }

        .notice {
            padding: 12px;
            border-radius: 8px;
            background: #e5f7eb;
            color: #176337;
            margin-bottom: 14px;
        }

        .error {
            background: #fde8e8;
            color: #942b2b;
        }

        .empty {
            text-align: center;
            color: #64748b;
            padding: 28px;
        }

        .actions {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            align-items: center;
        }

        .actions form {
            margin: 0;
        }

        @media (max-width: 650px) {
            main {
                padding: 12px;
            }

            .top {
                padding: 16px;
            }
        }
    </style>
</head>

<body class="admin-page">
<%- include('../partials/admin-shell-start', {
    admin: admin,
    adminPageTitle: 'Customers',
    adminActivePage: 'customers'
}) %>
<main>

        <% if (message) { %>
            <div class="notice"><%= message %></div>
        <% } %>

        <% if (error) { %>
            <div class="notice error"><%= error %></div>
        <% } %>

        <!-- Customer search -->
        <section class="panel">

            <form
                class="search"
                action="/admin/customers"
                method="GET"
            >
                <input
                    type="search"
                    name="search"
                    value="<%= search %>"
                    placeholder="Search username, email or phone number"
                >

                <select name="status">
                    <option value="" <%= !status ? 'selected' : '' %>>
                        All account statuses
                    </option>

                    <option
                        value="active"
                        <%= status === 'active' ? 'selected' : '' %>
                    >
                        Active
                    </option>

                    <option
                        value="inactive"
                        <%= status === 'inactive' ? 'selected' : '' %>
                    >
                        Deactivated
                    </option>
                </select>

                <button type="submit">Search</button>

                <a
                    class="button secondary"
                    href="/admin/customers"
                >
                    Clear
                </a>
            </form>

            <p class="muted">
                Showing up to 500 matching accounts.
                Passwords are never selected or displayed here.
            </p>

        </section>

        <!-- Customer table -->
        <section class="table-wrap">

            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Address</th>
                        <th>Email verified</th>
                        <th>Account</th>
                        <th>Registered</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    <% if (!customers.length) { %>

                        <tr>
                            <td class="empty" colspan="9">
                                No matching customers found.
                            </td>
                        </tr>

                    <% } else { %>

                        <% customers.forEach(customer => { %>

                            <tr>
                                <td><%= customer.id %></td>

                                <td>
                                    <strong>
                                        <%= customer.username || 'â€”' %>
                                    </strong>
                                </td>

                                <td><%= customer.email || 'â€”' %></td>

                                <td>
                                    <%= customer.phone_number || 'â€”' %>
                                </td>

                                <td><%= customer.address || 'â€”' %></td>

                                <td>
                                    <span class="pill <%= customer.is_verified ? '' : 'no' %>">
                                        <%= customer.is_verified
                                            ? 'Verified'
                                            : 'Not verified' %>
                                    </span>
                                </td>

                                <td>
                                    <span class="pill <%= customer.is_active ? '' : 'no' %>">
                                        <%= customer.is_active
                                            ? 'Active'
                                            : 'Deactivated' %>
                                    </span>
                                </td>

                                <td>
                                    <%= customer.created_at
                                        ? new Date(customer.created_at).toLocaleString('en-NG')
                                        : 'â€”' %>
                                </td>

                                <td>
                                    <div class="actions">

                                        <a
                                            class="button"
                                            href="/admin/customers/<%= customer.id %>"
                                        >
                                            Details
                                        </a>

                                        <a
                                            class="button secondary"
                                            href="/admin/customers/<%= customer.id %>/edit"
                                        >
                                            Edit
                                        </a>

                                        <!-- Activate / deactivate -->
                                        <form
                                            method="POST"
                                            action="/admin/customers/<%= customer.id %>/active"
                                        >
                                            <input
                                                type="hidden"
                                                name="_csrf"
                                                value="<%= csrfToken %>"
                                            >

                                            <input
                                                type="hidden"
                                                name="active"
                                                value="<%= customer.is_active ? '0' : '1' %>"
                                            >

                                            <button
                                                class="<%= customer.is_active ? 'red' : 'green' %>"
                                                type="submit"
                                            >
                                                <%= customer.is_active
                                                    ? 'Deactivate'
                                                    : 'Activate' %>
                                            </button>
                                        </form>

                                        <!-- Delete customer -->
                                        <form
                                            method="POST"
                                            action="/admin/customers/<%= customer.id %>/delete"
                                            onsubmit="return confirm('Permanently delete this customer account? Historical order and service records will be retained where stored separately. This cannot be undone.');"
                                        >
                                            <input
                                                type="hidden"
                                                name="_csrf"
                                                value="<%= csrfToken %>"
                                            >

                                            <button
                                                class="red"
                                                type="submit"
                                            >
                                                Delete
                                            </button>
                                        </form>

                                    </div>
                                </td>
                            </tr>

                        <% }); %>

                    <% } %>

                </tbody>
            </table>

        </section>

    </main>

<%- include('../partials/admin-shell-end') %>

