
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventory History | CapCentral Admin</title>

    <style>
        :root {
            --primary: #263449;
            --accent: #263449;
            --background: #f4f6f8;
            --surface: #ffffff;
            --border: #e1e5eb;
            --muted: #667085;
            --success: #18794e;
            --danger: #b42318;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            background: var(--background);
            color: #24312b;
            font-family: Arial, sans-serif;
        }

        .container {
            max-width: 1250px;
            margin: auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 24px;
        }

        h1 {
            margin: 0 0 8px;
            color: var(--primary);
        }

        .subtitle {
            margin: 0;
            color: var(--muted);
        }

        .button {
            display: inline-block;
            padding: 11px 16px;
            border: 0;
            border-radius: 7px;
            background: var(--primary);
            color: white;
            text-decoration: none;
            font-weight: 600;
            cursor: pointer;
        }

        .panel {
            padding: 20px;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: var(--surface);
            box-shadow: 0 3px 12px rgb(0 0 0 / 3%);
        }

        .table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            min-width: 950px;
            border-collapse: collapse;
        }

        th, td {
            padding: 13px 12px;
            border-bottom: 1px solid var(--border);
            text-align: left;
            font-size: 14px;
        }

        th {
            background: #f0f4f1;
            color: var(--primary);
            white-space: nowrap;
        }

        .change {
            font-weight: 700;
            white-space: nowrap;
        }

        .positive {
            color: var(--success);
        }

        .negative {
            color: var(--danger);
        }

        .neutral {
            color: var(--muted);
        }

        .empty {
            padding: 35px;
            text-align: center;
            color: var(--muted);
        }

        @media (max-width: 600px) {
            body {
                padding: 0;
            }

            .header {
                align-items: flex-start;
                flex-direction: column;
            }

            .button {
                width: 100%;
                text-align: center;
            }

            .panel {
                padding: 12px;
            }
        }
    </style>
</head>

<body class="admin-page">
    <%- include('../partials/admin-shell-start', {
        admin: admin,
        adminPageTitle: 'Inventory History',
        adminActivePage: 'inventory-history'
    }) %>
    <main class="container">
        <div class="header">
    <p class="subtitle">Stock adjustments and inventory movement records.</p>
    <a href="/admin/products" class="button">Back to Products</a>
</div>

        <section class="panel">
            <% if (movements && movements.length > 0) { %>
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Product</th>
                                <th>Product Code</th>
                                <th>Previous Stock</th>
                                <th>Change</th>
                                <th>New Stock</th>
                                <th>Reason</th>
                                <th>Admin</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% movements.forEach(movement => { %>
                                <tr>
                                    <td>
                                        <%= new Date(movement.created_at).toLocaleString('en-NG') %>
                                    </td>

                                    <td>
                                        <strong><%= movement.product_name %></strong>
                                    </td>

                                    <td>
                                        <%= movement.product_code %>
                                    </td>

                                    <td>
                                        <%= movement.previous_quantity %>
                                    </td>

                                    <td>
                                        <% const change = Number(movement.change_quantity); %>
                                        <span class="change <%= change > 0 ? 'positive' : change < 0 ? 'negative' : 'neutral' %>">
                                            <%= change > 0 ? '+' : '' %><%= change %>
                                        </span>
                                    </td>

                                    <td>
                                        <%= movement.new_quantity %>
                                    </td>

                                    <td>
                                        <%= movement.reason %>
                                    </td>

                                    <td>
                                        <%= movement.admin_name %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty">
                    No inventory movement records found.
                </div>
            <% } %>
        </section>
    </main>
<%- include('../partials/admin-shell-end') %>

