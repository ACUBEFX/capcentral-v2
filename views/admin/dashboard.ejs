<script>
    // Admin mobile navigation - overlay sidebar
    const adminNavToggle = document.getElementById('admin-mobile-toggle');
    const adminSidebar = document.querySelector('.sidebar');
    const adminSidebarNav = document.getElementById('admin-sidebar-nav');
    const adminNavBackdrop = document.getElementById('admin-nav-backdrop');

    function closeAdminMenu() {
        if (!adminSidebar || !adminNavToggle || !adminNavBackdrop) return;

        adminSidebar.classList.remove('admin-sidebar-open');
        adminNavBackdrop.classList.remove('admin-backdrop-open');
        document.body.classList.remove('admin-menu-open');

        adminNavToggle.setAttribute('aria-expanded', 'false');
        adminNavToggle.setAttribute('aria-label', 'Open navigation');
        adminNavToggle.textContent = '☰';
    }

    if (adminNavToggle && adminSidebar && adminSidebarNav && adminNavBackdrop) {
        adminNavToggle.addEventListener('click', () => {
            const isOpen = adminSidebar.classList.contains('admin-sidebar-open');

            if (isOpen) {
                closeAdminMenu();
            } else {
                adminSidebar.classList.add('admin-sidebar-open');
                adminNavBackdrop.classList.add('admin-backdrop-open');
                document.body.classList.add('admin-menu-open');

                adminNavToggle.setAttribute('aria-expanded', 'true');
                adminNavToggle.setAttribute('aria-label', 'Close navigation');
                adminNavToggle.textContent = '✕';
            }
        });

        adminNavBackdrop.addEventListener('click', closeAdminMenu);

        adminSidebarNav.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', closeAdminMenu);
        });

        document.addEventListener('keydown', event => {
            if (event.key === 'Escape') closeAdminMenu();
        });
    }
</script>
</body>
</html>












