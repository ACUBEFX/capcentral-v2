<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Edit Customer | CapCentral Admin</title><style>
*{box-sizing:border-box}body{margin:0;background:#f4f6fb;color:#1e293b;font-family:Arial,sans-serif}.top{background:#fff;padding:20px 28px;border-bottom:1px solid #e2e8f0}main{max-width:760px;margin:28px auto;padding:0 16px}.panel{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:24px}h1{margin:0 0 8px;font-size:24px}.muted{color:#64748b;font-size:13px;line-height:1.5}.field{margin:18px 0}.field label{display:block;font-weight:700;font-size:13px;margin-bottom:7px}.field input,.field textarea{width:100%;padding:11px;border:1px solid #cbd5e1;border-radius:7px;font:inherit}.field textarea{min-height:95px}.button,button{display:inline-block;border:0;border-radius:7px;padding:11px 15px;background:#172554;color:#fff;text-decoration:none;font-weight:600;cursor:pointer}.secondary{background:#475569}.error{background:#fde8e8;color:#942b2b;padding:12px;border-radius:8px}
</style></head><body><header class="top"><a href="/admin/customers">← Back to customers</a> · <a href="/admin">Dashboard</a></header><main><section class="panel"><h1>Edit customer</h1><p class="muted">Customer ID: <%= customer.id %>. Passwords cannot be viewed or edited here.</p><% if(error){ %><div class="error"><%= error %></div><% } %><form method="POST" action="/admin/customers/<%= customer.id %>/edit"><div class="field"><label for="username">Username *</label><input id="username" name="username" maxlength="100" required value="<%= customer.username || '' %>"></div><div class="field"><label for="email">Email *</label><input id="email" name="email" type="email" maxlength="255" required value="<%= customer.email || '' %>"></div><div class="field"><label for="phone_number">Phone number</label><input id="phone_number" name="phone_number" maxlength="20" value="<%= customer.phone_number || '' %>"></div><div class="field"><label for="address">Address</label><textarea id="address" name="address" maxlength="1000"><%= customer.address || '' %></textarea></div><button type="submit">Save changes</button> <a class="button secondary" href="/admin/customers/<%= customer.id %>">Cancel</a></form></section></main></body></html>
