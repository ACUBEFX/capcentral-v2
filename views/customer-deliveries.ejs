<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>My Deliveries | CapCentral</title>
<style>*{box-sizing:border-box}body{margin:0;background:#f4f6fb;color:#1e293b;font-family:Arial,sans-serif}.top{padding:22px;background:white;border-bottom:1px solid #e2e8f0}main{max-width:1100px;margin:28px auto;padding:0 16px}h1{margin:0 0 6px;font-size:24px}.muted{font-size:13px;color:#64748b;line-height:1.5}.order{background:white;border:1px solid #e2e8f0;border-radius:12px;padding:18px;margin:14px 0}.row{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}.status{display:inline-block;background:#e2e8f0;border-radius:20px;padding:6px 10px;font-size:12px;text-transform:capitalize}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-top:16px}.label{font-size:12px;color:#64748b;margin-bottom:5px}.value{font-size:14px;overflow-wrap:anywhere}.empty{background:white;padding:28px;border-radius:12px;text-align:center;color:#64748b}a{color:#172554}@media(max-width:600px){main{margin:18px auto}}</style></head>
<body><header class="top"><h1>My Deliveries</h1><div class="muted">Track your CapCentral orders and delivery updates.</div></header><main><p><a href="/profile">← Back to my profile</a></p>
<% if (!orders.length) { %><div class="empty">You don't have any order records to track yet. After a successful checkout, your order will appear here.</div><% } %>
<% orders.forEach(order => { %><section class="order"><div class="row"><div><strong><%= order.order_reference %></strong><div class="muted">Placed <%= order.created_at ? new Date(order.created_at).toLocaleString('en-NG') : '—' %></div></div><span class="status"><%= order.order_status %></span></div><div class="grid"><div><div class="label">Order total</div><div class="value"><%= order.currency || 'NGN' %> <%= Number(order.total_amount || 0).toLocaleString('en-NG',{minimumFractionDigits:2,maximumFractionDigits:2}) %></div></div><div><div class="label">Delivery type</div><div class="value"><%= order.delivery_option || 'standard' %></div></div><div><div class="label">Tracking number</div><div class="value"><%= order.tracking_number || 'Not assigned yet' %></div></div><div><div class="label">Dispatch date</div><div class="value"><%= order.dispatch_date ? new Date(order.dispatch_date).toLocaleString('en-NG') : 'Not dispatched yet' %></div></div><div><div class="label">Delivered date</div><div class="value"><%= order.delivered_at ? new Date(order.delivered_at).toLocaleString('en-NG') : 'Not delivered yet' %></div></div><div><div class="label">Delivery address</div><div class="value"><%= order.delivery_address || 'Address not recorded' %></div></div><% if (order.delivery_notes) { %><div><div class="label">Delivery update</div><div class="value"><%= order.delivery_notes %></div></div><% } %></div></section><% }) %>
</main></body></html>
