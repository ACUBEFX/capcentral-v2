</head>

<body>

<%- include('partials/customer-account-nav', { activePage: 'deliveries' }) %>

<main>

    <a href="/profile" class="back-link">â† Back to My Profile</a>

    <div class="page-heading">
        <h1>My Deliveries</h1>
        <p>View your orders, check delivery progress and manage your order requests.</p>
        <div class="heading-line"></div>
    </div>

    <% if (!orders || orders.length === 0) { %>

        <div class="empty-state">
            <h2>No Orders Yet</h2>
            <p>
                You haven't placed any orders yet.
                Your orders will appear here after checkout.
            </p>
            <a href="/products" class="shop-button">Explore Products</a>
        </div>

    <% } else { %>

        <% orders.forEach(function(order) { %>

            <details class="order-card">

                <summary>
                    <div class="order-summary-left">
                        <div class="order-reference">
                            Order #<%= order.order_reference || order.id %>
                        </div>

                        <div class="order-date">
                            Placed:
                            <%= order.created_at
                                ? new Date(order.created_at).toLocaleString('en-NG')
                                : 'Date unavailable' %>
                        </div>
                    </div>

                    <div class="order-summary-right">
                        <span class="status <%= String(order.order_status || 'pending').toLowerCase() %>">
                            <%= order.order_status || 'Pending' %>
                        </span>
                        <span class="chevron">&#8250;</span>
                    </div>
                </summary>

                <div class="order-content">

                    <h2 class="section-title">Order Summary</h2>

                    <div class="details-grid">

                        <div class="detail-box">
                            <div class="detail-label">Order Total</div>
                            <div class="detail-value order-total">
                                <%= order.currency || 'NGN' %>
                                <%= Number(order.total_amount || 0).toLocaleString('en-NG', {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }) %>
                            </div>
                        </div>

                        <div class="detail-box">
                            <div class="detail-label">Order Status</div>
                            <div class="detail-value">
                                <%= order.order_status || 'Pending' %>
                            </div>
                        </div>

                        <div class="detail-box">
                            <div class="detail-label">Delivery Option</div>
                            <div class="detail-value">
                                <%= order.delivery_option || order.delivery_type || 'Standard' %>
                            </div>
                        </div>

                        <div class="detail-box">
                            <div class="detail-label">Tracking Number</div>
                            <div class="detail-value">
                                <%= order.tracking_number || 'Not assigned yet' %>
                            </div>
                        </div>

                        <div class="detail-box">
                            <div class="detail-label">Dispatch Date</div>
                            <div class="detail-value">
                                <%= order.dispatch_date
                                    ? new Date(order.dispatch_date).toLocaleDateString('en-NG')
                                    : 'Not dispatched yet' %>
                            </div>
                        </div>

                        <div class="detail-box">
                            <div class="detail-label">Delivered Date</div>
                            <div class="detail-value">
                                <%= order.delivered_at
                                    ? new Date(order.delivered_at).toLocaleDateString('en-NG')
                                    : (order.delivered_date
                                        ? new Date(order.delivered_date).toLocaleDateString('en-NG')
                                        : 'Not delivered yet') %>
                            </div>
                        </div>

                        <div class="detail-box">
                            <div class="detail-label">Delivery Address</div>
                            <div class="detail-value">
                                <%= order.delivery_address || 'Address not recorded' %>
                            </div>
                        </div>

                        <div class="detail-box">
                            <div class="detail-label">Customer</div>
                            <div class="detail-value">
                                <%= order.customer_name || '&#8212;' %>
                            </div>
                        </div>

                    </div>

                    <% if (order.items && order.items.length > 0) { %>

                        <div class="items-list">
                            <h2 class="section-title">Items in This Order</h2>

                            <% order.items.forEach(function(item) { %>
                                <div class="item-row">
                                    <div>
                                        <div class="item-name">
                                            <%= item.product_name || 'Product' %>
                                        </div>

                                        <div class="item-meta">
                                            <% if (item.product_size) { %>
                                                Size: <%= item.product_size %> Â·
                                            <% } %>
                                            Quantity: <%= item.quantity %>
                                        </div>
                                    </div>

                                    <div class="item-price">
                                        <%= order.currency || 'NGN' %>
                                        <%= Number(item.total_price || 0).toLocaleString('en-NG', {
                                            minimumFractionDigits: 2,
                                            maximumFractionDigits: 2
                                        }) %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>

                    <% } %>

                    <% if (order.delivery_notes) { %>
                        <div class="delivery-note">
                            <strong>Delivery Update:</strong><br>
                            <%= order.delivery_notes %>
                        </div>
                    <% } %>

                    <% if (Number(order.user_id) === Number(user.id) &&
                        !['cancelled', 'refunded', 'delivered'].includes(String(order.order_status || '').toLowerCase())) { %>

                        <div class="request-panel">
                            <h3>Request Order Cancellation</h3>
                            <p>
                                Submit a cancellation request for this order.
                                Your request will be reviewed by our team.
                            </p>

                            <form action="/profile/order-request" method="POST" class="request-form">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="order_id" value="<%= order.id %>">
                                <input type="hidden" name="request_type" value="cancellation">

                                <textarea name="reason"
                                    placeholder="Please explain why you want to cancel this order..."
                                    maxlength="2000"
                                    required></textarea>

                                <button type="submit">Submit Cancellation Request</button>
                            </form>
                        </div>

                    <% } %>

                    <% if (Number(order.user_id) === Number(user.id) &&
                        ['delivered', 'paid', 'processing', 'shipped'].includes(String(order.order_status || '').toLowerCase())) { %>

                        <div class="request-panel">
                            <h3>Request a Refund</h3>
                            <p>
                                If you have an issue with this order, you can submit
                                a refund request for review.
                            </p>

                            <form action="/profile/order-request" method="POST" class="request-form">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="order_id" value="<%= order.id %>">
                                <input type="hidden" name="request_type" value="refund">

                                <textarea name="reason"
                                    placeholder="Please explain why you are requesting a refund..."
                                    maxlength="2000"
                                    required></textarea>

                                <button type="submit">Submit Refund Request</button>
                            </form>
                        </div>

                    <% } %>

                </div>
            </details>

        <% }); %>

    <% } %>

    <% if (requests && requests.length > 0) { %>

        <section class="request-history">
            <h2 class="section-title">My Cancellation & Refund Requests</h2>

            <% requests.forEach(function(request) { %>

                <div class="request-item">

                    <div class="request-item-header">
                        <strong>
                            Order #<%= request.order_reference || request.order_id %>
                        </strong>

                        <span class="status <%= String(request.request_status || 'pending').toLowerCase() %>">
                            <%= request.request_status || 'Pending' %>
                        </span>
                    </div>

                    <p>
                        <strong>Request type:</strong>
                        <%= request.request_type || '&#8212;' %>
                    </p>

                    <p>
                        <strong>Reason:</strong>
                        <%= request.reason || 'No reason provided' %>
                    </p>

                    <% if (request.admin_note) { %>
                        <p>
                            <strong>Admin response:</strong>
                            <%= request.admin_note %>
                        </p>
                    <% } %>

                    <p>
                        <strong>Submitted:</strong>
                        <%= request.created_at
                            ? new Date(request.created_at).toLocaleString('en-NG')
                            : '&#8212;' %>
                    </p>

                </div>

            <% }); %>
        </section>

    <% } %>

</main>

<footer>
    <p>&copy; <%= new Date().getFullYear() %> CapCentral. All rights reserved.</p>
</footer>

    <script src="/customer-account-nav.js" defer></script>
    <script src="/customer-bottom-nav.js" defer></script>
</body>
</html>




