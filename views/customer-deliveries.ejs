
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Deliveries | CapCentral</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #333;
            --secondary-color: #555;
            --accent-color: #8B4513;
            --text-color: #333;
            --light-bg: #f5f5f5;
            --white: #fff;
            --border-radius: 10px;
            --box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background: var(--light-bg);
            color: var(--text-color);
            min-height: 100vh;
        }

        /* Header */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 5%;
            min-height: 65px;
            background: #000;
            color: #fff;
            box-shadow: 0 2px 10px rgba(0,0,0,.1);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #fff;
            text-decoration: none;
        }

        .logo img {
            width: 65px;
            height: auto;
            object-fit: contain;
        }

        #brandname {
            color: #fff;
            font-family: 'Lora', serif;
            font-size: 23px;
            font-weight: 600;
        }

        .header-link {
            color: #fff;
            text-decoration: none;
            font-size: 13px;
            transition: var(--transition);
        }

        .header-link:hover {
            color: var(--accent-color);
        }

        /* Navigation */
        nav {
            background: var(--secondary-color);
            padding: 12px 5%;
        }

        .nav-container {
            max-width: 1200px;
            margin: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 25px;
            flex-wrap: wrap;
        }

        .nav-links a {
            color: #fff;
            text-decoration: none;
            font-size: 13px;
            transition: var(--transition);
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: #d7a77c;
        }

        /* Main content */
        main {
            max-width: 1200px;
            margin: 35px auto;
            padding: 0 5%;
        }

        .page-heading {
            text-align: center;
            margin-bottom: 30px;
        }

        .page-heading h1 {
            font-family: 'Lora', serif;
            font-size: 30px;
            margin-bottom: 10px;
        }

        .page-heading p {
            color: #666;
            font-size: 14px;
            line-height: 1.6;
        }

        .heading-line {
            width: 75px;
            height: 3px;
            background: var(--accent-color);
            margin: 14px auto 0;
        }

        .back-link {
            display: inline-block;
            margin-bottom: 22px;
            color: var(--accent-color);
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        /* Order dropdown cards */
        .order-card {
            background: var(--white);
            border-radius: var(--border-radius);
            box-shadow: var(--box-shadow);
            margin-bottom: 18px;
            overflow: hidden;
            border: 1px solid #eee;
            transition: var(--transition);
        }

        .order-card:hover {
            box-shadow: 0 8px 22px rgba(0,0,0,.1);
        }

        .order-card summary {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            padding: 20px;
            cursor: pointer;
            list-style: none;
        }

        .order-card summary::-webkit-details-marker {
            display: none;
        }

        .order-card summary:hover {
            background: #faf8f6;
        }

        .order-summary-left {
            min-width: 0;
        }

        .order-reference {
            font-size: 15px;
            font-weight: 700;
            overflow-wrap: anywhere;
            margin-bottom: 7px;
        }

        .order-date {
            color: #777;
            font-size: 12px;
        }

        .order-summary-right {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }

        .chevron {
            color: var(--accent-color);
            font-size: 20px;
            transition: transform .3s ease;
        }

        details[open] .chevron {
            transform: rotate(180deg);
        }

        /* Status labels */
        .status {
            display: inline-block;
            padding: 6px 11px;
            border-radius: 30px;
            font-size: 11px;
            font-weight: 700;
            text-transform: capitalize;
            background: #eee;
            color: #555;
        }

        .status.delivered,
        .status.paid,
        .status.approved,
        .status.success {
            background: #e7f5e9;
            color: #24743a;
        }

        .status.pending,
        .status.processing,
        .status.reserved {
            background: #fff3df;
            color: #98600b;
        }

        .status.cancelled,
        .status.refunded,
        .status.rejected,
        .status.failed {
            background: #fdeaea;
            color: #a52b2b;
        }

        .status.shipped {
            background: #e8f0ff;
            color: #28569b;
        }

        /* Order content */
        .order-content {
            padding: 22px;
            border-top: 1px solid #eee;
        }

        .section-title {
            font-family: 'Lora', serif;
            font-size: 17px;
            margin-bottom: 15px;
        }

        .details-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
            margin-bottom: 25px;
        }

        .detail-box {
            padding: 14px;
            background: #fafafa;
            border: 1px solid #eee;
            border-radius: 8px;
            min-width: 0;
        }

        .detail-label {
            color: #777;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .04em;
            margin-bottom: 7px;
        }

        .detail-value {
            font-size: 13px;
            font-weight: 600;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        .order-total {
            color: var(--accent-color);
            font-size: 17px;
        }

        /* Order items */
        .items-list {
            margin-bottom: 25px;
        }

        .item-row {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            padding: 13px 0;
            border-bottom: 1px solid #eee;
            font-size: 13px;
        }

        .item-row:last-child {
            border-bottom: none;
        }

        .item-name {
            font-weight: 600;
            overflow-wrap: anywhere;
        }

        .item-meta {
            color: #777;
            font-size: 12px;
            margin-top: 5px;
        }

        .item-price {
            color: var(--accent-color);
            font-weight: 700;
            white-space: nowrap;
        }

        /* Delivery notes */
        .delivery-note {
            padding: 15px;
            margin-bottom: 22px;
            background: #faf5f0;
            border-left: 4px solid var(--accent-color);
            border-radius: 5px;
            font-size: 13px;
            line-height: 1.6;
        }

        /* Request forms */
        .request-panel {
            margin-top: 22px;
            padding: 20px;
            background: #fafafa;
            border: 1px solid #eee;
            border-radius: 9px;
        }

        .request-panel h3 {
            font-family: 'Lora', serif;
            font-size: 16px;
            margin-bottom: 10px;
        }

        .request-panel p {
            color: #666;
            font-size: 12px;
            line-height: 1.6;
            margin-bottom: 14px;
        }

        .request-form {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .request-form textarea {
            width: 100%;
            min-height: 90px;
            resize: vertical;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 13px;
            outline: none;
        }

        .request-form textarea:focus {
            border-color: var(--accent-color);
            box-shadow: 0 0 0 3px rgba(139,69,19,.1);
        }

        .request-form button {
            align-self: flex-start;
            padding: 11px 20px;
            color: #fff;
            background: #000;
            border: none;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition);
        }

        .request-form button:hover {
            background: var(--accent-color);
        }

        .request-history {
            margin-top: 25px;
        }

        .request-item {
            padding: 15px;
            margin-bottom: 12px;
            background: #fff;
            border: 1px solid #eee;
            border-radius: 8px;
        }

        .request-item-header {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 8px;
        }

        .request-item p {
            font-size: 13px;
            color: #666;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        /* Empty state */
        .empty-state {
            padding: 50px 20px;
            background: #fff;
            border-radius: var(--border-radius);
            box-shadow: var(--box-shadow);
            text-align: center;
        }

        .empty-state h2 {
            font-family: 'Lora', serif;
            margin-bottom: 12px;
        }

        .empty-state p {
            color: #777;
            font-size: 13px;
            line-height: 1.7;
            margin-bottom: 20px;
        }

        .shop-button {
            display: inline-block;
            padding: 12px 22px;
            color: #fff;
            background: #000;
            border-radius: 8px;
            text-decoration: none;
            font-size: 12px;
            font-weight: 700;
            transition: var(--transition);
        }

        .shop-button:hover {
            background: var(--accent-color);
            color: #fff;
        }

        /* Footer */
        footer {
            margin-top: 55px;
            padding: 30px 5%;
            background: #030303;
            color: #fff;
            text-align: center;
        }

        footer p {
            font-size: 12px;
            color: #bbb;
            line-height: 1.7;
        }

       /* =========================================
   COMPLETE RESPONSIVE LAYOUT
========================================= */

/* Prevent horizontal overflow */
html {
    width: 100%;
    overflow-x: hidden;
    scroll-behavior: smooth;
}

body {
    width: 100%;
    min-width: 0;
    overflow-x: hidden;
}

header,
nav,
main,
footer {
    width: 100%;
    min-width: 0;
}

main {
    max-width: 1200px;
    margin: 35px auto;
    padding: 0 24px;
}

/* Keep long content from expanding the page */
.order-card,
.order-content,
.order-summary-left,
.order-summary-right,
.detail-box,
.request-panel,
.request-item,
.item-row {
    min-width: 0;
    max-width: 100%;
}

.order-reference,
.detail-value,
.item-name,
.request-item p,
.delivery-note {
    overflow-wrap: anywhere;
    word-break: break-word;
}

/* Navigation */
.nav-container {
    width: 100%;
    flex-wrap: wrap;
}

.nav-links {
    width: 100%;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px 25px;
}

/* Order summary */
.order-card summary {
    min-width: 0;
}

.order-summary-right {
    flex-wrap: wrap;
    justify-content: flex-end;
}

/* Order details */
.details-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
}

.detail-box {
    min-width: 0;
}

/* Order items */
.item-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
}

.item-row > div:first-child {
    flex: 1;
    min-width: 0;
}

.item-price {
    flex-shrink: 0;
    white-space: normal;
    text-align: right;
    overflow-wrap: anywhere;
}

/* Forms */
.request-form {
    width: 100%;
}

.request-form textarea {
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
}

.request-form button {
    max-width: 100%;
    white-space: normal;
}

/* Tablet */
@media (max-width: 992px) {
    main {
        max-width: 100%;
        padding: 0 22px;
    }

    .details-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .order-content {
        padding: 20px;
    }

    .nav-links {
        gap: 15px 20px;
    }
}

/* Mobile */
@media (max-width: 768px) {
    header {
        padding: 12px 18px;
        gap: 12px;
    }

    .logo {
        min-width: 0;
        gap: 8px;
    }

    .logo img {
        width: 48px;
    }

    #brandname {
        font-size: 19px;
    }

    .header-link {
        font-size: 12px;
        white-space: nowrap;
    }

    nav {
        padding: 12px 18px;
    }

    .nav-container {
        justify-content: center;
    }

    .nav-links {
        justify-content: center;
        gap: 12px 20px;
    }

    .nav-links a {
        font-size: 12px;
        display: inline-block;
        padding: 5px 0;
    }

    main {
        margin: 25px auto;
        padding: 0 16px;
    }

    .page-heading {
        margin-bottom: 24px;
    }

    .page-heading h1 {
        font-size: 25px;
    }

    .page-heading p {
        font-size: 13px;
    }

    .order-card summary {
        padding: 16px;
        gap: 12px;
    }

    .order-reference {
        font-size: 13px;
    }

    .order-content {
        padding: 17px;
    }

    .details-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .detail-box {
        padding: 12px;
    }

    .detail-value {
        font-size: 12px;
    }

    .section-title {
        font-size: 16px;
    }

    .request-panel {
        padding: 16px;
    }

    .request-form button {
        width: 100%;
        align-self: stretch;
    }

    .empty-state {
        padding: 35px 16px;
    }

    footer {
        margin-top: 35px;
        padding: 25px 16px;
    }
}

/* Small phones */
@media (max-width: 480px) {
    header {
        padding: 10px 12px;
    }

    .logo img {
        width: 40px;
    }

    #brandname {
        font-size: 17px;
    }

    .header-link {
        font-size: 11px;
    }

    nav {
        padding: 10px 12px;
    }

    .nav-links {
        justify-content: space-between;
        gap: 8px;
    }

    .nav-links a {
        font-size: 11px;
    }

    main {
        margin: 20px auto;
        padding: 0 12px;
    }

    .back-link {
        margin-bottom: 16px;
    }

    .page-heading h1 {
        font-size: 22px;
    }

    .page-heading p {
        font-size: 12px;
    }

    .order-card {
        margin-bottom: 14px;
        border-radius: 8px;
    }

    .order-card summary {
        padding: 13px 11px;
        gap: 7px;
    }

    .order-summary-left {
        flex: 1;
    }

    .order-summary-right {
        flex-direction: column;
        align-items: flex-end;
        gap: 5px;
    }

    .order-reference {
        font-size: 12px;
    }

    .order-date {
        font-size: 10px;
        line-height: 1.5;
    }

    .status {
        padding: 5px 8px;
        font-size: 9px;
    }

    .chevron {
        font-size: 17px;
    }

    .order-content {
        padding: 13px 11px;
    }

    .details-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
    }

    .detail-box {
        padding: 10px 8px;
    }

    .detail-label {
        font-size: 9px;
    }

    .detail-value {
        font-size: 11px;
        line-height: 1.5;
    }

    .order-total {
        font-size: 13px;
    }

    .item-row {
        gap: 8px;
        padding: 12px 0;
        font-size: 11px;
    }

    .item-meta {
        font-size: 10px;
    }

    .item-price {
        font-size: 11px;
    }

    .delivery-note {
        padding: 12px;
        font-size: 11px;
    }

    .request-panel {
        padding: 13px 10px;
    }

    .request-panel h3 {
        font-size: 14px;
    }

    .request-panel p {
        font-size: 11px;
    }

    .request-form textarea {
        font-size: 12px;
        min-height: 85px;
    }

    .request-form button {
        font-size: 11px;
        padding: 12px 8px;
    }

    .request-item {
        padding: 12px;
    }

    .request-item p {
        font-size: 11px;
    }

    .empty-state h2 {
        font-size: 19px;
    }

    .empty-state p {
        font-size: 12px;
    }
}

/* Very small phones */
@media (max-width: 360px) {
    header {
        flex-wrap: wrap;
        justify-content: center;
    }

    .header-link {
        padding: 5px;
    }

    .nav-links {
        justify-content: center;
        gap: 8px 14px;
    }

    .details-grid {
        grid-template-columns: 1fr;
    }

    .order-card summary {
        align-items: flex-start;
    }

    .order-summary-right {
        flex-shrink: 0;
    }

    .item-row {
        flex-direction: column;
    }

    .item-price {
        text-align: left;
    }
}

/* Accessibility: reduce motion when requested */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
    }
}
